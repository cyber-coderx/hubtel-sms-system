# Hubtel SMS API Configuration
HUBTEL_CLIENT_ID=your_client_id_here
HUBTEL_CLIENT_SECRET=your_client_secret_here
HUBTEL_SENDER_ID=MYAPP

# Server Configuration
PORT=3000
NODE_ENV=development

# API Configuration
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=5

# Database (optional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hubtel_sms
DB_USER=postgres
DB_PASSWORD=

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Security
CORS_ORIGIN=http://localhost:3000
API_KEY=your_api_key_optional
